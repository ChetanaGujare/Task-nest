{
  "name": "tasknest-api",
  "version": "1.0.0",
  "description": "TaskNest — Secure full-stack task manager API with Express, MySQL, JWT, Caching, and Swagger",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
